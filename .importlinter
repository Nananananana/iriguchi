[importlinter]
include_external_packages = True
root_packages =
    iriguchi

# The direction, asserted. The stdlib-only rule for the domain is a separate
# check in tests/test_architecture.py, because import-linter cannot express
# "everything except the standard library".
[importlinter:contract:layers]
name = Layer dependency direction
type = layers
layers =
    iriguchi.interfaces
    iriguchi.config
    iriguchi.evaluation
    iriguchi.application
    iriguchi.infrastructure
    iriguchi.ports
    iriguchi.domain
exhaustive = false

[importlinter:contract:domain-purity]
name = The domain layer knows nothing below it
type = forbidden
source_modules =
    iriguchi.domain
forbidden_modules =
    iriguchi.ports
    iriguchi.application
    iriguchi.infrastructure
    iriguchi.interfaces
    iriguchi.evaluation
    iriguchi.config

# ADR-0001: the domain decides, and deciding needs no I/O. A domain that can
# open a file can be given a different answer by whatever wrote the file.
[importlinter:contract:domain-no-io]
name = The domain layer does not touch the filesystem or the clock
type = forbidden
source_modules =
    iriguchi.domain
forbidden_modules =
    pathlib
    os
    sqlite3
    tomllib
    argparse
    subprocess

# ADR-0004 and the promise the whole project rests on: a routing decision is
# made before anything is sent, so the deciding path must have no way to send.
#
# Through v0.1 there was no outbound path at all, so this was stricter than the
# eventual rule: nothing in the package may touch the network.
#
# v0.2 landed the first thing that has to send, and the exemption is written as
# **one named import** rather than by dropping `iriguchi.infrastructure` from the
# sources or listing the packages that are still banned. Both of those permit the
# *next* adapter silently -- a new package under `infrastructure/` would simply
# not be covered -- and the comment this replaces asked for the opposite: that a
# new adapter has to be added here deliberately. An `ignore_imports` line is the
# spelling where that is true, because the exemption is a path and not a
# category.
#
# What is still banned, and is the actual promise: `domain`, `ports`,
# `application`, `evaluation`, `interfaces`, and every part of `infrastructure`
# except this one module. The deciding path has no way to send, which is what
# ADR-0004 claims and what `route --dry-run` rests on.
[importlinter:contract:no-network]
name = Nothing touches the network
type = forbidden
source_modules =
    iriguchi.domain
    iriguchi.ports
    iriguchi.application
    iriguchi.infrastructure
    iriguchi.evaluation
    iriguchi.interfaces
forbidden_modules =
    socket
    ssl
    http
    urllib
    asyncio
ignore_imports =
    iriguchi.infrastructure.models.openai_compatible -> urllib

# ADR-0005. mamori is an adapter's business and nobody else's: the core stands
# alone, and a user who wants only a router gets one.
[importlinter:contract:mamori-is-an-adapter]
name = Only the adapters may know about mamori
type = forbidden
source_modules =
    iriguchi.domain
    iriguchi.ports
    iriguchi.application
    iriguchi.interfaces
    iriguchi.evaluation
forbidden_modules =
    mamori
# The CLI asks `mamori_is_available()` so that `doctor` can say mamori is absent
# without the tool failing to start. That is a transitive path to `mamori` and
# import-linter is right to see it -- but every `import mamori` in the adapter is
# inside a function, so importing the module does not require the package.
#
# The contract cannot express "optional". What it is really protecting is that
# `import iriguchi` works with mamori absent, and that is asserted where it can
# be asserted for real: `tests/test_mamori_absent.py` makes the import fail and
# drives the whole CLI, and the `zero runtime dependencies` CI job installs the
# wheel with no extras and runs it. The per-file ban on *naming* mamori outside
# an adapter is still enforced, by tests/test_architecture.py.
# One fewer than before. `config` used to import `mamori_scanner` to answer
# "is it available", and now asks the registry -- which is the single module
# permitted to name the sibling. The line for it was reported stale by
# import-linter itself the moment the import went away, which is the same
# guard shape this repository keeps building by hand.
ignore_imports =
    iriguchi.interfaces.cli.main -> iriguchi.infrastructure.scanners.mamori_scanner
    iriguchi.config -> iriguchi.infrastructure.channels.mamori_channel
    iriguchi.infrastructure.registry -> iriguchi.infrastructure.scanners.mamori_scanner

# ADR-0009. tsumugi is never imported anywhere, infrastructure included: that
# seam is a published JSON contract, and reading JSON is reading JSON. kiseki's
# adapter is the precedent.
[importlinter:contract:tsumugi-is-json]
name = Nothing imports tsumugi
type = forbidden
source_modules =
    iriguchi
forbidden_modules =
    tsumugi
